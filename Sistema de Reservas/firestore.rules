rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/admin_exists {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Motéis — leitura pública, escrita só admin/superadmin
    match /config/motels {
      allow read: if true;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'superadmin');
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'superadmin');
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'superadmin');
    }

    // Reservas — autenticados (chat anônimo ou dashboard)
    // As alterações de status são auditadas via campos status_origem e status_operador_uid
    match /reservas/{document} {
      allow read, write: if request.auth != null;
    }

    // Estabelecimentos (motéis)
    match /estabelecimentos/{estabId} {
      allow read: if request.auth != null;

      // Linktree / Encurtador — leitura pública (link.html), escrita autenticada
      match /linktree/{linkId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Config NPS — leitura pública (nps.html), escrita autenticada
      match /config/nps {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Respostas NPS — leitura autenticada, criação pública (nps.html)
      match /nps_respostas/{respId} {
        allow read: if request.auth != null;
        allow create: if true;
        allow update, delete: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
