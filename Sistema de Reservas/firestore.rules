rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reservas - clientes podem criar, admins veem tudo
    match /reservas/{reservaId} {
      allow create: if true; // Chat cria reserva
      allow read: if request.auth != null || true; // Admin autenticado OU webhook
      allow update: if request.auth != null 
        && request.auth.token.role in ['admin', 'superadmin', 'funcionario'];
      allow delete: if request.auth != null 
        && request.auth.token.role == 'superadmin';
    }

    // Configuração dos motéis - apenas admins
    match /config/{docId} {
      allow read: if true; // Chat precisa ler suítes/preços
      allow write: if request.auth != null 
        && request.auth.token.role in ['admin', 'superadmin'];
    }

    // Usuários - apenas o próprio ou admin
    match /usuarios/{userId} {
      allow read: if request.auth != null 
        && (request.auth.uid == userId 
            || request.auth.token.role in ['admin', 'superadmin']);
      allow write: if request.auth != null 
        && (request.auth.uid == userId 
            || request.auth.token.role in ['admin', 'superadmin']);
    }

    // NPS - clientes criam, admins leem
    match /nps/{npsId} {
      allow create: if true;
      allow read: if request.auth != null 
        && request.auth.token.role in ['admin', 'superadmin'];
    }

    // Linktree - público para leitura
    match /linktree/{linkId} {
      allow read: if true;
      allow write: if request.auth != null 
        && request.auth.token.role in ['admin', 'superadmin'];
    }
  }
}